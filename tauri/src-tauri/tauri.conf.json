{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WifiPriority",
  "version": "1.1.3",
  "identifier": "com.wifipriority.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WiFi 优先级",
        "url": "index.html",
        "width": 1000,
        "height": 680,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "title": "WiFi 悬浮框",
        "url": "overlay.html",
        "width": 260,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
