<Window x:Class="WifiPriority.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WifiPriority.Controls"
        Title="WiFi 优先级" Icon="Assets/app.ico" Width="1000" Height="680" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource WindowTint}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧导航 ================= -->
        <Grid Grid.Column="0" Margin="16,18,10,16">
            <StackPanel VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Margin="10,2,0,2">
                    <Image Source="Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="WiFi 优先级" Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="自动切换到最优网络" Style="{StaticResource Sub}" Margin="12,6,0,20"/>
                <RadioButton x:Name="NavOverview" Content="概览" Tag="Overview" GroupName="nav" IsChecked="True"
                             Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPriority" Content="优先级" Tag="Priority" GroupName="nav"
                             Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavNearby" Content="附近网络" Tag="Nearby" GroupName="nav"
                             Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavOverlay" Content="桌面悬浮框" Tag="Overlay" GroupName="nav"
                             Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" Content="设置" Tag="Settings" GroupName="nav"
                             Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavLog" Content="日志" Tag="Log" GroupName="nav"
                             Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" VerticalAlignment="Bottom" Margin="12,0,0,46" Style="{StaticResource Sub}"/>
            <Button Content="退出程序" VerticalAlignment="Bottom" Click="ExitApp_Click"/>
        </Grid>

        <!-- ================= 页面区 ================= -->
        <Grid Grid.Column="1" Margin="6,18,22,18">

            <!-- ========== 概览 ========== -->
            <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="概览" Style="{StaticResource H1}" Margin="0,0,0,14"/>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="当前连接" Style="{StaticResource Sub}"/>
                                <TextBlock x:Name="CurSsid" Text="检测中…" FontSize="30" FontWeight="SemiBold"
                                           Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CurDetail" Text="" Style="{StaticResource Sub}"/>
                                <Button x:Name="LocationBtn" Content="打开“位置服务”设置" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Visibility="Collapsed" Click="OpenLocation_Click"/>
                            </StackPanel>
                            <Viewbox Grid.Column="1" Width="64" Height="46" VerticalAlignment="Top">
                                <c:SignalBars x:Name="CurBars"/>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="自动切换" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="StateText" Text="" Style="{StaticResource Sub}" Margin="0,6,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PauseBtn" Content="暂停自动切换" Style="{StaticResource AccentButton}"
                                        Margin="0,0,8,0" Click="Pause_Click"/>
                                <Button Content="立即扫描" Click="ScanNow_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="最近一次切换" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="LastSwitchText" Text="尚无切换记录" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 优先级 ========== -->
            <Grid x:Name="PagePriority" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="优先级" Style="{StaticResource H1}"/>
                    <TextBlock Text="越靠上优先级越高：可拖动条目排序，也可点 ▲ ▼。网络名称需与 Windows 里保存的配置文件名一致。"
                               Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="网络名称 (SSID)" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NewSsid"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="密码（仅该网络尚未保存时填写）" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="NewPwd"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="添加到列表" Style="{StaticResource AccentButton}"
                                    VerticalAlignment="Bottom" Padding="16,8" Click="AddNetwork_Click"/>
                        </Grid>
                        <TextBlock x:Name="AddHint" Text="" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <ListBox x:Name="PriorityList" ItemContainerStyle="{StaticResource RowItem}" AllowDrop="True"
                             PreviewMouseLeftButtonDown="PriorityList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="PriorityList_PreviewMouseMove"
                             Drop="PriorityList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Ssid}" FontSize="14"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Sub}"
                                               Margin="12,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                    <c:SignalBars Grid.Column="3" Value="{Binding Signal}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Button Content="▲" Style="{StaticResource IconButton}" Click="PriUp_Click"/>
                                        <Button Content="▼" Style="{StaticResource IconButton}" Click="PriDown_Click"/>
                                        <Button Content="✕" Style="{StaticResource IconButton}" Margin="0" Click="PriDel_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="PriorityEmpty" Text="还没有网络，请在上方添加，或到“附近网络”里一键加入。"
                               Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"/>
                </Grid>
            </Grid>

            <!-- ========== 附近网络 ========== -->
            <Grid x:Name="PageNearby" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="附近网络" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="NearbyCount" Text="" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                </StackPanel>
                <ListBox x:Name="NearbyList" Grid.Row="1" ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Ssid}" FontSize="14"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Bands}" Style="{StaticResource Sub}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding SavedText}" Style="{StaticResource Sub}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                <c:SignalBars Grid.Column="3" Value="{Binding Signal}" Margin="14,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Signal, StringFormat={}{0}%}" Width="44"
                                           VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                                <Button Grid.Column="5" Content="{Binding ActionText}" IsEnabled="{Binding CanAdd}"
                                        Tag="{Binding Ssid}" Padding="12,5" Click="AddNearby_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ========== 桌面悬浮框 ========== -->
            <ScrollViewer x:Name="PageOverlay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="桌面悬浮框" Style="{StaticResource H1}"/>
                    <TextBlock Text="在桌面上显示当前连接的 WiFi。直接用鼠标拖动即可移动位置，右键有更多选项。"
                               Style="{StaticResource Sub}" Margin="0,4,0,14"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="OvEnabled" Content="显示桌面悬浮框" Style="{StaticResource Switch}" Click="Overlay_Changed"/>
                            <CheckBox x:Name="OvShowSignal" Content="显示信号强度" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="Overlay_Changed"/>
                            <CheckBox x:Name="OvLocked" Content="锁定位置并鼠标穿透（悬浮框不再响应点击，需在此处或托盘菜单解锁）"
                                      Style="{StaticResource Switch}" Margin="0,14,0,0" Click="Overlay_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="显示层级" Style="{StaticResource H2}"/>
                            <TextBlock Text="悬浮在所有窗口之上：任何窗口都盖不住它；只显示在桌面：被其他窗口盖住，回到桌面时才看得到。"
                                       Style="{StaticResource Sub}" Margin="0,4,0,10"/>
                            <WrapPanel>
                                <RadioButton x:Name="OvLayerTop" Content="悬浮在所有窗口之上" Tag="Top" GroupName="ovlayer"
                                             Style="{StaticResource SegButton}" Checked="OverlayLayer_Checked"/>
                                <RadioButton x:Name="OvLayerDesktop" Content="只显示在桌面" Tag="Desktop" GroupName="ovlayer"
                                             Style="{StaticResource SegButton}" Checked="OverlayLayer_Checked"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="透明度" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OvOpacityText" HorizontalAlignment="Right" Style="{StaticResource Sub}"/>
                            </Grid>
                            <Slider x:Name="OvOpacity" Minimum="0.3" Maximum="1" Margin="0,6,0,0" ValueChanged="OvSlider_Changed"/>
                            <Grid Margin="0,16,0,0">
                                <TextBlock Text="大小" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OvScaleText" HorizontalAlignment="Right" Style="{StaticResource Sub}"/>
                            </Grid>
                            <Slider x:Name="OvScale" Minimum="0.8" Maximum="1.6" Margin="0,6,0,0" ValueChanged="OvSlider_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="位置" Style="{StaticResource H2}"/>
                            <TextBlock Text="拖动悬浮框可自由摆放；也可以一键吸附到屏幕角落。" Style="{StaticResource Sub}" Margin="0,4,0,12"/>
                            <WrapPanel>
                                <Button Content="左上角" Tag="TopLeft" Margin="0,0,8,8" Click="Anchor_Click"/>
                                <Button Content="右上角" Tag="TopRight" Margin="0,0,8,8" Click="Anchor_Click"/>
                                <Button Content="左下角" Tag="BottomLeft" Margin="0,0,8,8" Click="Anchor_Click"/>
                                <Button Content="右下角" Tag="BottomRight" Margin="0,0,8,8" Click="Anchor_Click"/>
                                <Button Content="恢复默认外观" Margin="0,0,8,8" Click="OvReset_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 设置 ========== -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource H1}" Margin="0,0,0,14"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="启动与外观" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="AutoStartSwitch" Content="开机自启（任务计划，最高权限，登录后后台常驻）"
                                      Style="{StaticResource Switch}" Margin="0,12,0,0" Click="AutoStart_Click"/>
                            <TextBlock x:Name="AutoStartHint" Text="首次开启需要确认一次管理员授权（UAC）。若移动了 exe 的位置，请关闭后重新开启。"
                                       Style="{StaticResource Sub}" Margin="52,4,0,0"/>
                            <TextBlock Text="主题" Margin="0,18,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" Content="跟随系统" Tag="System" GroupName="theme"
                                             Style="{StaticResource SegButton}" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeLight" Content="云母白" Tag="Light" GroupName="theme"
                                             Style="{StaticResource SegButton}" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeDark" Content="墨夜" Tag="Dark" GroupName="theme"
                                             Style="{StaticResource SegButton}" Checked="Theme_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="频段偏好（5G / 2.4G）" Style="{StaticResource H2}"/>
                            <TextBlock Text="同一个 WiFi 常同时开放 2.4G 和 5G：5G 更快但穿墙差。这里决定遇到多个频段时怎么选。"
                                       Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                            <TextBlock Text="频段策略" Margin="0,14,0,8"/>
                            <WrapPanel>
                                <RadioButton x:Name="PolicyGlobal" Content="全局偏好频段优先" Tag="Global" GroupName="bandpolicy"
                                             Style="{StaticResource SegButton}" Checked="Band_Checked"/>
                                <RadioButton x:Name="PolicySame" Content="仅同一网络内" Tag="Same" GroupName="bandpolicy"
                                             Style="{StaticResource SegButton}" Checked="Band_Checked"/>
                                <RadioButton x:Name="PolicyOff" Content="不区分频段" Tag="Off" GroupName="bandpolicy"
                                             Style="{StaticResource SegButton}" Checked="Band_Checked"/>
                            </WrapPanel>
                            <TextBlock Text="优先频段" Margin="0,14,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Prefer5" Content="5G 优先（6G &gt; 5G &gt; 2.4G）" Tag="5G" GroupName="bandprefer"
                                             Style="{StaticResource SegButton}" Checked="Band_Checked"/>
                                <RadioButton x:Name="Prefer24" Content="2.4G 优先" Tag="2.4G" GroupName="bandprefer"
                                             Style="{StaticResource SegButton}" Checked="Band_Checked"/>
                            </StackPanel>
                            <TextBlock x:Name="BandHint" Text="" Style="{StaticResource Sub}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="切换策略" Style="{StaticResource H2}"/>
                            <TextBlock Text="信号强度是 Windows 报告的百分比（约等于 2 × (dBm + 100)，60% ≈ −70 dBm，40% ≈ −80 dBm）。"
                                       Style="{StaticResource Sub}" Margin="0,4,0,10"/>

                            <Grid Margin="0,6">
                                <TextBlock Text="主动扫描间隔（秒，0 = 连续扫描，最快）" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbInterval" Width="84" HorizontalAlignment="Right" TextAlignment="Right" LostFocus="Settings_Changed"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="切换到更高优先级所需的信号 ≥ (%)" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbUp" Width="84" HorizontalAlignment="Right" TextAlignment="Right" LostFocus="Settings_Changed"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="当前网络信号低于 (%) 视为过弱/消失，回落到次优先级" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbDown" Width="84" HorizontalAlignment="Right" TextAlignment="Right" LostFocus="Settings_Changed"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="确认时间（毫秒，候选保持最优这么久才切换，0 = 立即）" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbConfirmMs" Width="84" HorizontalAlignment="Right" TextAlignment="Right" LostFocus="Settings_Changed"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="两次“升级”切换的最短间隔（秒；信号丢失时的回落不受限制）" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbCooldown" Width="84" HorizontalAlignment="Right" TextAlignment="Right" LostFocus="Settings_Changed"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="检测到手动换网后暂停自动切换（分钟，0 = 不暂停）" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbManualPause" Width="84" HorizontalAlignment="Right" TextAlignment="Right" LostFocus="Settings_Changed"/>
                            </Grid>

                            <CheckBox x:Name="SwTakeover" Content="当前连接的网络不在优先级列表里时，也自动切到列表中的网络"
                                      Style="{StaticResource Switch}" Margin="0,16,0,0" Click="Settings_Changed"/>
                            <CheckBox x:Name="SwInternet" Content="联网检测：连上 12 秒后仍连续检测不到互联网时，回落到下一个网络"
                                      Style="{StaticResource Switch}" Margin="0,12,0,0" Click="Settings_Changed"/>
                            <CheckBox x:Name="SwNotify" Content="切换时弹出系统通知"
                                      Style="{StaticResource Switch}" Margin="0,12,0,0" Click="Settings_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 日志 ========== -->
            <Grid x:Name="PageLog" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="日志" Style="{StaticResource H1}"/>
                    <Button Content="清空" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearLog_Click"/>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                    <ListBox x:Name="LogList" FontFamily="Consolas, Microsoft YaHei UI">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,2"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
