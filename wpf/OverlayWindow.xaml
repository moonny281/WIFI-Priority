<Window x:Class="WifiPriority.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WifiPriority.Controls"
        Title="WiFi 悬浮框"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="False" Focusable="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimary}">
    <Border x:Name="Root" Margin="10" CornerRadius="12" Padding="14,10"
            Background="{DynamicResource OverlayBg}"
            BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1"
            Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28"/>
        </Border.Effect>
        <Border.LayoutTransform>
            <ScaleTransform x:Name="ScaleT" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开主窗口" Click="OpenMain_Click"/>
                <MenuItem Header="吸附到屏幕角落">
                    <MenuItem Header="左上角" Tag="TopLeft" Click="Anchor_Click"/>
                    <MenuItem Header="右上角" Tag="TopRight" Click="Anchor_Click"/>
                    <MenuItem Header="左下角" Tag="BottomLeft" Click="Anchor_Click"/>
                    <MenuItem Header="右下角" Tag="BottomRight" Click="Anchor_Click"/>
                </MenuItem>
                <MenuItem Header="锁定位置（鼠标穿透）" Click="Lock_Click"/>
                <MenuItem Header="隐藏悬浮框" Click="Hide_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Orientation="Horizontal">
            <c:SignalBars x:Name="Bars" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SsidText" Text="WiFi 检测中…" FontSize="14" FontWeight="SemiBold"
                           MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubText" Text="" FontSize="11.5" Margin="0,1,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
