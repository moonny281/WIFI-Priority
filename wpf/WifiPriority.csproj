<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WifiPriority</AssemblyName>
    <RootNamespace>WifiPriority</RootNamespace>
    <Version>1.0.0</Version>
    <!-- 版本号唯一来源：仓库根目录的 VERSION 文件（CI 也读它） -->
    <Version Condition="Exists('$(MSBuildThisFileDirectory)..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
    <Product>WiFi Priority</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Description>Auto-switch WiFi by your own priority list</Description>

    <!-- 单文件、自包含：用户电脑无需安装 .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- v1.1.9 降低后台内存：关闭并发（后台）GC，省掉一套后台 GC 线程和额外堆；不用工作站以外的 GC；分层 PGO 关掉（省 JIT 内存） -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- GC 更积极地压缩堆、归还内存（0-9，越大越省内存、GC 越频繁；5 对这种空闲程序很合适） -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\tray-connected.ico" />
    <Resource Include="Assets\tray-idle.ico" />
    <Resource Include="Assets\tray-paused.ico" />
  </ItemGroup>

</Project>
